# Local build environment. Copy to `.env` and fill in the value.
#
# VITE_TMDB_KEY — free TMDB API key (v3 auth), used for the Movies catalog
# when the catalog mirror refuses our domain. Get one at
# https://www.themoviedb.org/settings/api (Request an API Key -> Developer).
#
# `.env` is gitignored. Production gets this from the GitHub Actions secret
# VITE_TMDB_KEY, never from this file.
VITE_TMDB_KEY=
